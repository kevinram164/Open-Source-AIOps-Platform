# Template for OpenAI API key secret.
# 1. Copy to openai-api-key.secret.yaml
# 2. Replace CHANGE_ME with your actual API key
# 3. Apply: oc apply -f openai-api-key.secret.yaml
# 4. NEVER commit the .secret.yaml file (see .gitignore)
apiVersion: v1
kind: Secret
metadata:
  name: openai-api-key
  namespace: aiops-core
  labels:
    app.kubernetes.io/part-of: open-aiops-platform
    app.kubernetes.io/component: rca-agent
type: Opaque
stringData:
  OPENAI_API_KEY: "CHANGE_ME"
