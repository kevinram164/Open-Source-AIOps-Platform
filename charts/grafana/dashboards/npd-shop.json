{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "title": "Pods Running (npd-shop)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "count(kube_pod_status_phase{namespace=\"npd-shop\",phase=\"Running\"})", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },
    {
      "title": "Unavailable replicas",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "sum(kube_deployment_status_replicas_unavailable{namespace=\"npd-shop\"}) or vector(0)", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },
    {
      "title": "CPU by pod",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"npd-shop\",container!=\"\"}[5m]))", "legendFormat": "{{pod}}", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },
    {
      "title": "Memory by pod",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{ "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"npd-shop\",container!=\"\"})", "legendFormat": "{{pod}}", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    }
  ],
  "schemaVersion": 39,
  "tags": ["npd", "shop"],
  "templating": {
    "list": [{ "name": "datasource", "type": "datasource", "query": "prometheus", "current": { "text": "Prometheus", "value": "Prometheus" } }]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "NPD Shop",
  "uid": "npd-shop",
  "version": 1
}
